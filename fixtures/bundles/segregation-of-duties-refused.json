   "statement":
   "insert into actor (id, organisation_id, display_name) values ('11111111-1111-1111-1111-111111111111','6a892ae3-d66b-47c4-ade1-0098927f8464','Priya (maker)'),('22222222-2222-2222-2222-222222222222','6a892ae3-d66b-47c4-ade1-0098927f8464','Wei (checker)'),('33333333-3333-3333-3333-333333333333','6a892ae3-d66b-47c4-ade1-0098927f8464','Nadia (checker)'),('44444444-4444-4444-4444-444444444444','6a892ae3-d66b-47c4-ade1-0098927f8464','Sam (controller)'),('55555555-5555-5555-5555-555555555555','6a892ae3-d66b-47c4-ade1-0098927f8464','Rae (auditor)'),('66666666-6666-6666-6666-666666666666','6a892ae3-d66b-47c4-ade1-0098927f8464','Tom (second operator)'); insert into actor_role (actor_id, role) values ('11111111-1111-1111-1111-111111111111','operator'),('22222222-2222-2222-2222-222222222222','approver'),('33333333-3333-3333-3333-333333333333','approver'),('44444444-4444-4444-4444-444444444444','controller'),('55555555-5555-5555-5555-555555555555','auditor'),('66666666-6666-6666-6666-666666666666','operator'); insert into approver_limit (actor_id, currency, limit_minor) values ('22222222-2222-2222-2222-222222222222','SGD',500000),('33333333-3333-3333-3333-333333333333','SGD',5000000); insert into approval_threshold (organisation_id, currency, from_minor, approvals_required) values ('6a892ae3-d66b-47c4-ade1-0098927f8464','SGD',0,1),('6a892ae3-d66b-47c4-ade1-0098927f8464','SGD',100000,2);",
